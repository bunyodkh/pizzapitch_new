# Copy this file to .env and fill in real values. Never commit .env itself.

# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# False in production. Leave unset (or False) on the droplet.
DEBUG=False

# Comma-separated, no spaces around commas needed. Must include the domain(s)
# nginx serves this app on.
ALLOWED_HOSTS=example.com,www.example.com

# Comma-separated, each with scheme — required for CSRF checks over HTTPS.
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Keep False until certbot/HTTPS is confirmed working on the domain, then
# flip to True and redeploy — see DEPLOY.md.
SECURE_SSL_REDIRECT=False

# Telegram notifications (events/telegram_notify.py) — see the comment
# above these settings in config/settings.py for what each value means
# and how to find TELEGRAM_GROUP_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
