msgid_plural "%(counter)s applications"
msgstr[0] "%(counter)s заявка"
msgstr[1] "%(counter)s заявки"
msgstr[2] "%(counter)s заявок"
msgstr[3] "%(counter)s заявок"

msgid "Delete this event? This cannot be undone."
msgstr "Удалить это мероприятие? Действие нельзя отменить."

msgid "Delete"
msgstr "Удалить"

