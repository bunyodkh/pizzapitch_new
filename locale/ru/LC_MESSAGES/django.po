msgstr "Мероприятие"

msgid "No events"
msgstr "Нет мероприятий"

msgid "All events"
msgstr "Все мероприятия"

msgid "past"
msgstr "прошло"

msgid "Type"
msgstr "Тип"

msgid "All"
msgstr "Все"

msgid "Startups"
msgstr "Стартапы"

msgid "Guests"
msgstr "Гости"

msgid "Subscribers"
msgstr "Подписчики"

msgid "Status"
msgstr "Статус"

msgid "Show"
msgstr "Показать"

msgid "Name"
msgstr "Имя"

msgid "Edit"
msgstr "Изменить"

msgid "No contacts match the selected filters."
msgstr "Контактов по выбранным фильтрам нет."

msgid "Edit event"
msgstr "Редактировать мероприятие"

msgid "New event"
msgstr "Новое мероприятие"

msgid "Remove photo"
msgstr "Удалить фото"

msgid "Upload photo"
msgstr "Загрузить фото"

msgid "Create and manage PizzaPitch events."
msgstr "Создавайте и управляйте мероприятиями PizzaPitch."

msgid "inactive"
msgstr "неактивно"

#, python-format
